<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>DipLabSim.UI</RootNamespace>
    <AssemblyName>DipLabSim.UI</AssemblyName>
    <!-- Suppress SkiaSharp target framework warning if needed -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DipLabSim.Core\DipLabSim.Core.csproj" />
    <ProjectReference Include="..\DipLabSim.Physics\DipLabSim.Physics.csproj" />
    <ProjectReference Include="..\DipLabSim.Engine\DipLabSim.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.0" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

</Project>
