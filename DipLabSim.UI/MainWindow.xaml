<Window x:Class="DipLabSim.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DipLabSim.UI.Views"
        xmlns:vm="clr-namespace:DipLabSim.UI.ViewModels"
        mc:Ignorable="d"
        Title="DipLabSim — Double Inverted Pendulum Laboratory Simulator (Week 1)"
        Height="850" Width="1300"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Transport Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- 1. TOP TRANSPORT & SELECTION BAR           -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDarkBrush}" 
                BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="True">

                <!-- Left Branding / Status Indicator -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <!-- Status Pulse Dot -->
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource AccentAmberBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentGreenBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="DipLabSim" FontWeight="Bold" FontSize="15" Foreground="{StaticResource AccentCyanBrush}" />
                        <TextBlock Text="DIPC LAB SIMULATOR" FontSize="9" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Controls: Speed Selector -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Speed:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                    <ComboBox ItemsSource="{Binding AvailableSpeeds}" SelectedItem="{Binding SelectedSpeed}"
                              Style="{StaticResource LabComboBox}" Width="70" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='{}{0}x'}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Center Section: Plant Selector, Controller Selector & Transport Buttons -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Plant Model Selector -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Plant Model:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                        <ComboBox ItemsSource="{Binding AvailablePlants}" SelectedItem="{Binding CurrentPlant}"
                                  DisplayMemberPath="Name" Style="{StaticResource LabComboBox}" Width="230" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Controller Selector + Discovery Actions -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Controller:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                        <ComboBox ItemsSource="{Binding AvailableControllers}" SelectedItem="{Binding SelectedController}"
                                  DisplayMemberPath="DisplayName" Style="{StaticResource LabComboBox}" Width="260" VerticalAlignment="Center" />
                        <Button Content="↻ Refresh" Command="{Binding RefreshControllersCommand}" Style="{StaticResource LabButton}" Margin="4,0,2,0" ToolTip="Rescan ./Controllers folder for .dll plugins" />
                        <Button Content="📂 Dir" Command="{Binding OpenControllersFolderCommand}" Style="{StaticResource LabButton}" Margin="2,0,0,0" ToolTip="Open ./Controllers folder in Explorer" />
                    </StackPanel>

                    <!-- Simulation Transport: Play/Pause and Reset -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                        <Button Command="{Binding TogglePlayPauseCommand}" Margin="0,0,6,0" MinWidth="85">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LabAccentButton}">
                                    <Setter Property="Content" Value="▶ Play" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Content" Value="⏸ Pause" />
                                            <Setter Property="Background" Value="#382800" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentAmberBrush}" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="⏮ Reset" Command="{Binding ResetSimulationCommand}" Style="{StaticResource LabButton}" MinWidth="75" ToolTip="Reset simulation state to zero" />
                    </StackPanel>

                </WrapPanel>

            </DockPanel>
        </Border>

        <!-- ========================================== -->
        <!-- 2. MAIN WORKSPACE (SIDEBAR + 2D + SCOPE)   -->
        <!-- ========================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar (Collapsible / Resizable) -->
                <ColumnDefinition Width="380" MinWidth="260" MaxWidth="550" />
                <!-- Sidebar Splitter -->
                <ColumnDefinition Width="4" />
                <!-- Right Workspace (Visualizer + Scopes) -->
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceDarkBrush}" 
                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <TabControl Style="{StaticResource LabTabControl}" BorderThickness="0">

                    <!-- TAB 1: MODEL PARAMETERS -->
                    <TabItem Header="Plant Parameters" Style="{StaticResource LabTabItem}">
                        <DockPanel LastChildFill="True">

                            <!-- Model Info Header Banner -->
                            <Border DockPanel.Dock="Top" Background="#11131E" Padding="12,10" 
                                    BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="{Binding CurrentPlant.Name}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" />
                                    <TextBlock Grid.Row="1" Text="{Binding CurrentPlant.Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <Button Grid.Row="2" Content="↺ Reset Parameters to Default" Command="{Binding ResetParametersToDefaultCommand}" Style="{StaticResource LabButton}" HorizontalAlignment="Left" Padding="8,4" FontSize="11" />
                                </Grid>
                            </Border>

                            <!-- Parameter Items List (Grouped by Category) -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                                <ItemsControl ItemsSource="{Binding ParameterItemsView}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="#1C2032" Padding="8,4" Margin="0,8,0,3" CornerRadius="3" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" />
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,2" Padding="6,4" Background="#141724" CornerRadius="3" BorderBrush="#1F2436" BorderThickness="1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding HeaderLabel}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ValueString, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource LabTextBox}" Width="75" TextAlignment="Right" Height="22" Padding="4,2" />

                                                    <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}"
                                                            SmallChange="{Binding Step}" LargeChange="{Binding Step}" Value="{Binding Value}"
                                                            Margin="0,4,0,0" Style="{StaticResource LabSlider}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- TAB 2: MANUAL STATE PREVIEW (Week 1 Interactive Test) -->
                    <TabItem Header="Manual State Preview" Style="{StaticResource LabTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                            <StackPanel Orientation="Vertical">

                                <!-- Guidance Card -->
                                <Border Background="#11131E" Padding="10" CornerRadius="4" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Margin="0,0,0,12">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Text="WEEK 1 VISUALIZER TEST" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" FontSize="11" Margin="0,0,0,4" />
                                        <TextBlock Text="When paused, scrub these sliders to interactively verify coordinate transformations, angle conventions, and live pendulum kinematics on screen." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Angle Preset Buttons -->
                                <TextBlock Text="Quick Angle Presets:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button Content="Upright (0, 0)" Command="{Binding SetUprightPresetCommand}" Style="{StaticResource LabButton}" Margin="0,0,6,6" FontSize="11" Padding="8,4" />
                                    <Button Content="Hanging (π, π)" Command="{Binding SetHangingPresetCommand}" Style="{StaticResource LabButton}" Margin="0,0,6,6" FontSize="11" Padding="8,4" />
                                    <Button Content="Perturbed" Command="{Binding SetPerturbedPresetCommand}" Style="{StaticResource LabButton}" Margin="0,0,6,6" FontSize="11" Padding="8,4" />
                                    <Button Content="Zero All" Command="{Binding ZeroManualStateCommand}" Style="{StaticResource LabButton}" Margin="0,0,0,6" FontSize="11" Padding="8,4" />
                                </WrapPanel>

                                <!-- Slider 1: Cart Position x -->
                                <Border Background="#141724" Padding="10" CornerRadius="4" BorderBrush="#1F2436" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel Orientation="Vertical">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Cart Position (x):" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11" DockPanel.Dock="Left" />
                                            <TextBlock Text="{Binding ManualX, StringFormat='{}{0:+0.000;-0.000;0.000} m'}" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" DockPanel.Dock="Right" />
                                        </DockPanel>
                                        <Slider Minimum="-2.0" Maximum="2.0" SmallChange="0.01" LargeChange="0.1" Value="{Binding ManualX}" Style="{StaticResource LabSlider}" Margin="0,6,0,0" />
                                        <DockPanel LastChildFill="False" Margin="0,2,0,0">
                                            <TextBlock Text="-2.0 m" Foreground="{StaticResource TextMutedBrush}" FontSize="9" DockPanel.Dock="Left" />
                                            <TextBlock Text="+2.0 m" Foreground="{StaticResource TextMutedBrush}" FontSize="9" DockPanel.Dock="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Slider 2: Link 1 Angle Theta1 -->
                                <Border Background="#141724" Padding="10" CornerRadius="4" BorderBrush="#1F2436" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel Orientation="Vertical">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Link 1 Angle (θ₁):" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11" DockPanel.Dock="Left" />
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <TextBlock Text="{Binding ManualTheta1, StringFormat='{}{0:+0.00;-0.00;0.00} rad'}" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ManualTheta1Deg, StringFormat='({0:+0.0;-0.0;0.0}°)'}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Slider Minimum="-3.14159" Maximum="3.14159" SmallChange="0.01" LargeChange="0.1" Value="{Binding ManualTheta1}" Style="{StaticResource LabSlider}" Margin="0,6,0,0" />
                                        <DockPanel LastChildFill="False" Margin="0,2,0,0">
                                            <TextBlock Text="-π (-180°)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" DockPanel.Dock="Left" />
                                            <TextBlock Text="+π (+180°)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" DockPanel.Dock="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Slider 3: Link 2 Angle Theta2 -->
                                <Border Background="#141724" Padding="10" CornerRadius="4" BorderBrush="#1F2436" BorderThickness="1" Margin="0,0,0,10">
                                    <StackPanel Orientation="Vertical">
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="Link 2 Angle (θ₂):" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11" DockPanel.Dock="Left" />
                                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                                <TextBlock Text="{Binding ManualTheta2, StringFormat='{}{0:+0.00;-0.00;0.00} rad'}" Foreground="{StaticResource AccentAmberBrush}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Margin="0,0,4,0" />
                                                <TextBlock Text="{Binding ManualTheta2Deg, StringFormat='({0:+0.0;-0.0;0.0}°)'}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Slider Minimum="-3.14159" Maximum="3.14159" SmallChange="0.01" LargeChange="0.1" Value="{Binding ManualTheta2}" Style="{StaticResource LabSlider}" Margin="0,6,0,0" />
                                        <DockPanel LastChildFill="False" Margin="0,2,0,0">
                                            <TextBlock Text="-π (-180°)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" DockPanel.Dock="Left" />
                                            <TextBlock Text="+π (+180°)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" DockPanel.Dock="Right" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- SIDEBAR VERTICAL SPLITTER -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="#1C1F30" Cursor="SizeWE" />

            <!-- RIGHT WORKSPACE: 2D VISUALIZER (TOP) + SCOTTPLOT SCOPE (BOTTOM) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Top 65%: SkiaSharp 2D Visualizer -->
                    <RowDefinition Height="65*" MinHeight="250" />
                    <!-- Workspace Horizontal Splitter -->
                    <RowDefinition Height="4" />
                    <!-- Bottom 35%: ScottPlot 5 Real-Time Scopes -->
                    <RowDefinition Height="35*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- TOP: SKIASHARP 2D VISUALIZER -->
                <Border Grid.Row="0" Background="#0D0D14" ClipToBounds="True">
                    <views:PendulumCanvasControl x:Name="PendulumCanvas"
                                                State="{Binding CurrentState}"
                                                ControlForceU="{Binding ControlForceU}"
                                                L1="{Binding L1}"
                                                L2="{Binding L2}" />
                </Border>

                <!-- WORKSPACE HORIZONTAL SPLITTER -->
                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Background="#1C1F30" Cursor="SizeNS" />

                <!-- BOTTOM: SCOTTPLOT 5 REAL-TIME SCOPE -->
                <Border Grid.Row="2" Background="#12131C">
                    <views:TelemetryScopeControl x:Name="TelemetryScope" />
                </Border>
            </Grid>
        </Grid>

        <!-- ========================================== -->
        <!-- 3. BOTTOM STATUS BAR                       -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceHeaderBrush}"
                BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel LastChildFill="True">

                <!-- Left: Status Badge & Message -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="3" Padding="6,2" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#382800" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="#0A3C2A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock FontSize="10" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="⏸ PAUSED" />
                                    <Setter Property="Foreground" Value="{StaticResource AccentAmberBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Text" Value="▶ RUNNING" />
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreenBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Right: Telemetry coordinates summary -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SimulatedTime, StringFormat='t = {0:F2} s'}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding CurrentX, StringFormat='x = {0:+0.00;-0.00;0.00} m'}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding CurrentTheta1, StringFormat='θ₁ = {0:+0.00;-0.00;0.00} rad'}" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding CurrentTheta2, StringFormat='θ₂ = {0:+0.00;-0.00;0.00} rad'}" Foreground="{StaticResource AccentAmberBrush}" FontFamily="Consolas" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding ControlForceU, StringFormat='u = {0:+0.00;-0.00;0.00} N'}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" />
                </StackPanel>

            </DockPanel>
        </Border>

    </Grid>
</Window>
