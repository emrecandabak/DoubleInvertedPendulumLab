<UserControl x:Class="DipLabSim.UI.Views.TelemetryScopeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="800">
    <Grid Background="#12131C">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Scope 1: Cart Position x(t) -->
        <Border Grid.Row="0" Margin="2,1,2,1">
            <sp:WpfPlot x:Name="CartPlot" />
        </Border>

        <Border Grid.Row="1" Background="#232738" />

        <!-- Scope 2: Angles theta1(t) & theta2(t) -->
        <Border Grid.Row="2" Margin="2,1,2,1">
            <sp:WpfPlot x:Name="AnglesPlot" />
        </Border>

        <Border Grid.Row="3" Background="#232738" />

        <!-- Scope 3: Control Input u(t) -->
        <Border Grid.Row="4" Margin="2,1,2,1">
            <sp:WpfPlot x:Name="ControlPlot" />
        </Border>
    </Grid>
</UserControl>
